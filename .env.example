# Copy to .env and fill in. .env is git-ignored. NEVER put real keys in this file.
# Keys and rules like fees/funding must NOT be hard-coded in code: keys live here, rules come from the PDFs.

# --- Team ---
TEAM_ID=

# --- LLM (must support image input) ---
LLM_PROVIDER=            # anthropic | openai
LLM_MODEL=               # model id for the provider chosen
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings / retrieval ---
EMBEDDING_PROVIDER=      # openai | local | bm25
EMBEDDING_MODEL=

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Paths ---
KNOWLEDGE_BASE_DIR=knowledge_base
TEMPLATES_DIR=templates
SEED_DATA_DIR=seed_data
RESULTS_DIR=results
DB_PATH=data/app.db
